{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Jaza Docs",
  "description": "Prepaid billing infrastructure for African apps — credit wallets, Mobile Money top-ups, FX, and USD settlements handled by Jaza.",
  "colors": {
    "primary": "#2DD4BF",
    "light": "#5EEAD4",
    "dark": "#0D9488"
  },
  "favicon": "/favicon.svg",
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "canonical": "https://docs.jaza.dev",
      "robots": "index, follow",
      "og:site_name": "Jaza Docs",
      "og:locale": "en_US",
      "twitter:card": "summary_large_image",
      "twitter:site": "@jazadev"
    },
    "organization": {
      "id": "https://jaza.dev/#organization",
      "name": "Jaza",
      "legalName": "Polele SAS",
      "url": "https://jaza.dev",
      "logo": "https://docs.jaza.dev/logo/dark.svg",
      "sameAs": [
        "https://x.com/jazadev",
        "https://linkedin.com/company/jaza",
        "https://github.com/Polele-Inc/jaza"
      ]
    }
  },
  "redirects": [
    {
      "source": "/concepts/features-and-bundles",
      "destination": "/concepts/features"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "guides/authentication"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "concepts/credits",
              "concepts/wallets",
              "concepts/ledger",
              "concepts/features",
              "concepts/bundles",
              "concepts/settlements",
              "concepts/webhooks"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/dashboard-setup",
              "guides/handshake",
              "guides/top-up",
              "guides/gating-actions",
              "guides/consume-credits",
              "guides/webhooks"
            ]
          },
          {
            "group": "SDKs",
            "pages": ["sdks/node", "sdks/react-native", "sdks/react"]
          },
          {
            "group": "Reference",
            "pages": ["reference/errors", "reference/supported-currencies"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://jaza.dev/dashboard",
          "icon": "grid-2"
        },
        {
          "anchor": "jaza.dev",
          "href": "https://jaza.dev",
          "icon": "globe"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:privacy@jaza.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://jaza.dev/dashboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/jazadev",
      "github": "https://github.com/Polele-Inc/jaza",
      "linkedin": "https://linkedin.com/company/jaza"
    }
  }
}
