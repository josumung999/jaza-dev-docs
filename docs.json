{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Jaza Docs",
  "description": "Prepaid billing SDKs for African apps — credit wallets, Mobile Money top-ups, and settlements handled by Jaza.",
  "colors": {
    "primary": "#2DD4BF",
    "light": "#5EEAD4",
    "dark": "#0D9488"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Get started",
        "pages": ["index", "quickstart"]
      },
      {
        "group": "Guides",
        "pages": ["guides/concepts", "guides/authentication"]
      },
      {
        "group": "SDKs",
        "pages": ["sdks/node", "sdks/react-native"]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://jaza.dev/dashboard",
          "icon": "grid-2"
        },
        {
          "anchor": "jaza.dev",
          "href": "https://jaza.dev",
          "icon": "globe"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:privacy@jaza.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://jaza.dev/dashboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/jazadev",
      "github": "https://github.com/josumung999",
      "linkedin": "https://linkedin.com/company/jaza"
    }
  }
}
